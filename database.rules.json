{
  "rules": {
    ".read": false,
    ".write": false,
    "roles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "academicSessions": {
      ".read": true,
      ".write": "auth != null && root.child('roles').child(auth.uid).val() === 'principal'"
    },
    "systemSettings": {
      ".read": true,
      ".write": "auth != null && root.child('roles').child(auth.uid).val() === 'principal'"
    },
    "sessionData": {
      "$session": {
        ".read": "auth != null && (root.child('roles').child(auth.uid).val() === 'principal' || root.child('roles').child(auth.uid).val() === 'sec-ic' || root.child('roles').child(auth.uid).val() === 'pri-ic')",
        "$collection": {
          ".write": "auth != null && root.child('academicSessions').child($session).child('status').val() !== 'frozen' && (root.child('roles').child(auth.uid).val() === 'principal' || ((root.child('roles').child(auth.uid).val() === 'sec-ic' || root.child('roles').child(auth.uid).val() === 'pri-ic') && $collection !== 'students' && $collection !== 'sectionConfigs' && $collection !== 'teachers' && $collection !== 'classTeacherAssignments' && $collection !== 'examOptionsList' && $collection !== 'publishedSubjectDirectories'))"
        },
        "publishedSubjectDirectories": {
          ".read": "root.child('systemSettings').child('activeSession').val() === $session",
          ".write": "auth != null && root.child('roles').child(auth.uid).val() === 'principal' && root.child('academicSessions').child($session).child('status').val() !== 'frozen'"
        }
      }
    },
