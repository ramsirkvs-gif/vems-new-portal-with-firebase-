{
  "rules": {
    ".read": false,
    ".write": false,
    "roles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "academicSessions": {
      ".read": true,
      ".write": "auth != null && root.child('roles').child(auth.uid).val() === 'principal'"
    },
    "systemSettings": {
      ".read": true,
      ".write": "auth != null && root.child('roles').child(auth.uid).val() === 'principal'"
    },
    "examDayAttendancePins": {
      "$session": {
        "$exam": {
          "$date": {
            "$room": {
              ".read": false,
              ".write": "auth != null && (root.child('roles').child(auth.uid).val() === 'principal' || root.child('roles').child(auth.uid).val() === 'sec-ic' || root.child('roles').child(auth.uid).val() === 'pri-ic')"
            }
          }
        }
      }
    },
    "examDayAttendanceAccessChecks": {
      "$session": {
        "$exam": {
          "$date": {
            "$room": {
              "$attempt": {
                ".read": false,
                ".write": "newData.child('pin').isString() && newData.child('pin').val() === root.child('examDayAttendancePins').child($session).child($exam).child($date).child($room).val()"
              }
            }
          }
        }
      }
    },
    "examDayAttendanceSubmissions": {
      "$session": {
        ".read": "auth != null && (root.child('roles').child(auth.uid).val() === 'principal' || root.child('roles').child(auth.uid).val() === 'sec-ic' || root.child('roles').child(auth.uid).val() === 'pri-ic')",
        "$exam": {
          "$date": {
            "$room": {
              ".write": "(auth != null && (root.child('roles').child(auth.uid).val() === 'principal' || root.child('roles').child(auth.uid).val() === 'sec-ic' || root.child('roles').child(auth.uid).val() === 'pri-ic')) || (newData.child('pin').isString() && newData.child('pin').val() === root.child('examDayAttendancePins').child($session).child($exam).child($date).child($room).val())",
              ".validate": "!newData.exists() || newData.hasChildren(['pin','absentIds','submittedAt'])"
            }
          }
        }
      }
    },
    "sessionData": {
      "$session": {
        ".read": "auth != null && (root.child('roles').child(auth.uid).val() === 'principal' || root.child('roles').child(auth.uid).val() === 'sec-ic' || root.child('roles').child(auth.uid).val() === 'pri-ic')",
        "$collection": {
          ".write": "auth != null && root.child('academicSessions').child($session).child('status').val() !== 'frozen' && (root.child('roles').child(auth.uid).val() === 'principal' || ((root.child('roles').child(auth.uid).val() === 'sec-ic' || root.child('roles').child(auth.uid).val() === 'pri-ic') && $collection !== 'students' && $collection !== 'sectionConfigs' && $collection !== 'teachers' && $collection !== 'classTeacherAssignments' && $collection !== 'examOptionsList' && $collection !== 'publishedSubjectDirectories'))"
        },
        "publishedSubjectDirectories": {
          ".read": "root.child('systemSettings').child('activeSession').val() === $session",
          ".write": "auth != null && root.child('roles').child(auth.uid).val() === 'principal' && root.child('academicSessions').child($session).child('status').val() !== 'frozen'"
        },
        "publicPortalBoards": {
          ".read": "root.child('systemSettings').child('activeSession').val() === $session",
          ".write": "auth != null && root.child('academicSessions').child($session).child('status').val() !== 'frozen' && (root.child('roles').child(auth.uid).val() === 'principal' || root.child('roles').child(auth.uid).val() === 'sec-ic' || root.child('roles').child(auth.uid).val() === 'pri-ic')"
        }
